# =============================================================================
# Frontend Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# Backend API Base URL (required)
# The base URL for the backend API. Used by the frontend to make requests.
# In development, defaults to http://localhost:8000/v1 if not set.
VITE_API_BASE_URL=http://localhost:8000/v1

# Qdrant Vector DB Dashboard URL (optional)
# URL for the Qdrant dashboard UI for inspecting vector embeddings.
# Defaults to http://localhost:6333/dashboard if not set.
VITE_QDRANT_DASHBOARD_URL=http://localhost:6333/dashboard

# LiteLLM Proxy URL (optional)
# URL for the LiteLLM proxy dashboard to monitor LLM routing and tokens.
# Defaults to http://localhost:4000 if not set.
VITE_LITELLM_PROXY_URL=http://localhost:4000

# =============================================================================
# Notes:
# - VITE_ prefix is required for Vite to expose the variable to the client
# - Changes require restarting the dev server (npm run dev)
# - In production, set these via your hosting platform's environment variables
# =============================================================================
