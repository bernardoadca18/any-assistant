# =============================================================================
# UE5 AI Assistant — Variáveis de Ambiente
# Copie para .env e preencha os valores reais. NUNCA commite o .env.
# =============================================================================

# --- Redis do Agente (isolado do Redis do LiteLLM) ---------------------------
AGENT_REDIS_PASSWORD=

# --- LiteLLM (mesmo valor configurado no stack do LiteLLM) ------------------
LITELLM_MASTER_KEY=sk-

# --- Ollama (para geração de embeddings — mesmo modelo do ingestor) ----------
# Se Ollama roda no host da máquina, use host.docker.internal dentro do Docker
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Aplicação ---------------------------------------------------------------
APP_ENV=development          # production | development
LOG_LEVEL=DEBUG              # DEBUG | INFO | WARNING | ERROR